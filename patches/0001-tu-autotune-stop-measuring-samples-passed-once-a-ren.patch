From 5d8b5dd86f9939a9a4e796e5846dd60a75073d08 Mon Sep 17 00:00:00 2001
From: turnip-custom <turnip-custom@localhost>
Date: Fri, 20 Nov 2026 08:52:52 +0000
Subject: [PATCH 1/4] tu/autotune: stop measuring samples passed once a render
 pass has settled

In the default (bandwidth) algorithm every execution of a render pass emits
GPU commands that read the samples-passed counter before and after the pass,
and the CPU later reads the result back. Once a pass's running average has had
enough updates it rarely moves, so the measurement costs GPU and CPU power for
no gain.

After TU_AUTOTUNE_SETTLE updates (default 24) only one execution in
TU_AUTOTUNE_RESAMPLE (default 32) measures again, which still follows scene
changes. TU_AUTOTUNE_RESAMPLE=1 restores the stock behaviour.
---
 src/freedreno/vulkan/tu_autotune.cc | 34 +++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/src/freedreno/vulkan/tu_autotune.cc b/src/freedreno/vulkan/tu_autotune.cc
index 2e3dd4d..8137849 100644
--- a/src/freedreno/vulkan/tu_autotune.cc
+++ b/src/freedreno/vulkan/tu_autotune.cc
@@ -9,6 +9,7 @@
 #include <array>
 #include <atomic>
 #include <cmath>
+#include <cstdlib>
 #include <string>
 #include <string_view>
 
@@ -160,6 +161,11 @@ struct PACKED tu_autotune::config_t {
       return metric_flags & static_cast<uint32_t>(f);
    }
 
+   constexpr void clear_metric(metric_flag f)
+   {
+      metric_flags &= ~static_cast<uint8_t>(f);
+   }
+
    constexpr bool set_algo(algorithm a)
    {
       if (algo == a)
@@ -989,6 +995,14 @@ template <typename T = double> class adaptive_average {
    }
 };
 
+static uint32_t
+autotune_env_u32(const char *name, uint32_t def, uint32_t lo, uint32_t hi)
+{
+   const char *str = os_get_option(name);
+   uint32_t value = str ? static_cast<uint32_t>(strtoul(str, nullptr, 10)) : def;
+   return std::clamp(value, lo, hi);
+}
+
 /* All historical state pertaining to a uniquely identified RP. This integrates data from RP entries, accumulating
  * metrics over the long-term and providing autotune algorithms using the data.
  */
@@ -1015,11 +1029,28 @@ struct tu_autotune::rp_history {
    struct bandwidth_algo {
     private:
       exponential_average<uint32_t> mean_samples_passed;
+      std::atomic<uint32_t> updates = 0; /* How many results have been folded into the average. */
+      std::atomic<uint32_t> uses = 0;    /* How many times should_sample() was asked after settling. */
 
     public:
       void update(uint32_t samples)
       {
          mean_samples_passed.add(samples);
+         updates.fetch_add(1, std::memory_order_relaxed);
+      }
+
+      /* The samples-passed counter costs GPU commands and CPU post-processing for every execution of the RP. Once the
+       * average has had TU_AUTOTUNE_SETTLE updates (default 24) it is unlikely to move much, so after that only one in
+       * TU_AUTOTUNE_RESAMPLE executions (default 32) measures again, which is enough to follow scene changes.
+       * TU_AUTOTUNE_RESAMPLE=1 restores the stock behaviour of measuring every time.
+       */
+      bool should_sample()
+      {
+         static const uint32_t settle = autotune_env_u32("TU_AUTOTUNE_SETTLE", 24, 4, 1000);
+         static const uint32_t period = autotune_env_u32("TU_AUTOTUNE_RESAMPLE", 32, 1, 100000);
+         if (updates.load(std::memory_order_relaxed) < settle)
+            return true;
+         return (uses.fetch_add(1, std::memory_order_relaxed) % period) == 0;
       }
 
       render_mode get_optimal_mode(rp_history &history,
@@ -1927,6 +1958,9 @@ tu_autotune::get_optimal_mode(struct tu_cmd_buffer *cmd_buffer, rp_ctx_t *rp_ctx
          history.preempt_optimize.mark_as_latency_sensitive();
       }
    }
+   /* Skip the samples-passed measurement for RPs whose bandwidth estimate has settled, see should_sample(). */
+   if (config.test(metric_flag::SAMPLES) && !history.bandwidth.should_sample())
+      config.clear_metric(metric_flag::SAMPLES);
    *rp_ctx = cb_ctx.attach_rp_entry(device, std::move(history_handle), config, rp_state->drawcall_count);
 
    if (config.test(mod_flag::PREEMPT_OPTIMIZE) && history.preempt_optimize.is_latency_sensitive()) {
-- 
