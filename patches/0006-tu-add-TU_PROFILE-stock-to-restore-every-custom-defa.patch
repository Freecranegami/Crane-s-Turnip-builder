From 98ca6dd6b601264f9dbc741a90e2301bc55ca542 Mon Sep 17 00:00:00 2001
From: turnip-custom <turnip-custom@localhost>
Date: Fri, 20 Nov 2026 10:03:16 +0000
Subject: [PATCH 6/6] tu: add TU_PROFILE=stock to restore every custom default
 at once

This build changes several defaults for native mobile games: sparse autotune
sampling, an anisotropy cap, a SYSMEM margin, learned depth store skipping and
concurrent binning. TU_PROFILE=stock puts them all back to the upstream
behaviour so one variable is enough to A/B test against stock Turnip. The
individual switches still override the profile, and TU_DEBUG=startup prints the
active profile.
---
 src/freedreno/vulkan/tu_autotune.cc   |  4 ++--
 src/freedreno/vulkan/tu_cmd_buffer.cc |  2 +-
 src/freedreno/vulkan/tu_device.cc     |  5 +++++
 src/freedreno/vulkan/tu_sampler.cc    |  2 +-
 src/freedreno/vulkan/tu_util.cc       | 12 ++++++++++++
 src/freedreno/vulkan/tu_util.h        |  6 ++++++
 6 files changed, 27 insertions(+), 4 deletions(-)

diff --git a/src/freedreno/vulkan/tu_autotune.cc b/src/freedreno/vulkan/tu_autotune.cc
index d0aade4..a81b837 100644
--- a/src/freedreno/vulkan/tu_autotune.cc
+++ b/src/freedreno/vulkan/tu_autotune.cc
@@ -1047,7 +1047,7 @@ struct tu_autotune::rp_history {
       bool should_sample()
       {
          static const uint32_t settle = autotune_env_u32("TU_AUTOTUNE_SETTLE", 24, 4, 1000);
-         static const uint32_t period = autotune_env_u32("TU_AUTOTUNE_RESAMPLE", 32, 1, 100000);
+         static const uint32_t period = autotune_env_u32("TU_AUTOTUNE_RESAMPLE", tu_stock_profile() ? 1 : 32, 1, 100000);
          if (updates.load(std::memory_order_relaxed) < settle)
             return true;
          return (uses.fetch_add(1, std::memory_order_relaxed) % period) == 0;
@@ -1098,7 +1098,7 @@ struct tu_autotune::rp_history {
          /* SYSMEM traffic goes to DDR while GMEM traffic stays on chip, so equal byte counts are not equal energy. Only
           * pick SYSMEM when its estimate wins by at least TU_AUTOTUNE_SYSMEM_MARGIN percent (default 30, 0 = stock).
           */
-         static const uint64_t sysmem_margin = autotune_env_u32("TU_AUTOTUNE_SYSMEM_MARGIN", 30, 0, 50);
+         static const uint64_t sysmem_margin = autotune_env_u32("TU_AUTOTUNE_SYSMEM_MARGIN", tu_stock_profile() ? 0 : 30, 0, 50);
          bool select_sysmem = sysmem_bandwidth * 100 <= gmem_bandwidth * (100 - sysmem_margin);
          render_mode mode = select_sysmem ? render_mode::SYSMEM : render_mode::GMEM;
 
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 4af2b93..a989207 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -2079,7 +2079,7 @@ static uint32_t
 tu_ds_store_skip_threshold()
 {
    static const uint32_t threshold =
-      (uint32_t) CLAMP(debug_get_num_option("TU_DS_STORE_SKIP", 300), 0, 1000000);
+      (uint32_t) CLAMP(debug_get_num_option("TU_DS_STORE_SKIP", tu_stock_profile() ? 0 : 300), 0, 1000000);
    return threshold;
 }
 
diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index 76910e4..8c23c29 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -1963,6 +1963,11 @@ tu_init_dri_options(struct tu_instance *instance)
 
    turnip_parse_dri_options(&instance->drirc, &params);
 
+   if (TU_DEBUG(STARTUP))
+      mesa_logi("TU_PROFILE=%s", tu_stock_profile() ? "stock" : "mobile");
+   if (tu_stock_profile())
+      instance->drirc.perf.allow_concurrent_binning = false;
+
    if (TU_DEBUG(NO_CONCURRENT_BINNING))
       instance->drirc.perf.allow_concurrent_binning = false;
    if (TU_DEBUG(FORCE_CONCURRENT_BINNING))
diff --git a/src/freedreno/vulkan/tu_sampler.cc b/src/freedreno/vulkan/tu_sampler.cc
index 7622cc9..dbcc584 100644
--- a/src/freedreno/vulkan/tu_sampler.cc
+++ b/src/freedreno/vulkan/tu_sampler.cc
@@ -110,7 +110,7 @@ tu_CreateSampler(VkDevice _device,
     * 1 turns anisotropic filtering off.
     */
    static const uint32_t max_aniso_cap =
-      (uint32_t) CLAMP(debug_get_num_option("TU_MAX_ANISOTROPY", 8), 1, 16);
+      (uint32_t) CLAMP(debug_get_num_option("TU_MAX_ANISOTROPY", tu_stock_profile() ? 16 : 8), 1, 16);
    unsigned aniso = pCreateInfo->anisotropyEnable ?
       util_last_bit(MIN2(MIN2(static_cast<uint32_t>(pCreateInfo->maxAnisotropy), max_aniso_cap) >> 1, 8)) : 0;
    bool miplinear = (pCreateInfo->mipmapMode == VK_SAMPLER_MIPMAP_MODE_LINEAR);
diff --git a/src/freedreno/vulkan/tu_util.cc b/src/freedreno/vulkan/tu_util.cc
index 76e4f4a..f8eca34 100644
--- a/src/freedreno/vulkan/tu_util.cc
+++ b/src/freedreno/vulkan/tu_util.cc
@@ -18,6 +18,18 @@
 #include "tu_device.h"
 #include "tu_pass.h"
 
+#include "util/u_debug.h"
+
+bool
+tu_stock_profile(void)
+{
+   static const bool stock = []() {
+      const char *profile = debug_get_option("TU_PROFILE", "mobile");
+      return !strcmp(profile, "stock");
+   }();
+   return stock;
+}
+
 static const struct debug_control tu_debug_options[] = {
    { "startup", TU_DEBUG_STARTUP },
    { "nir", TU_DEBUG_NIR },
diff --git a/src/freedreno/vulkan/tu_util.h b/src/freedreno/vulkan/tu_util.h
index c212db4..a3d5df5 100644
--- a/src/freedreno/vulkan/tu_util.h
+++ b/src/freedreno/vulkan/tu_util.h
@@ -478,6 +478,12 @@ tu_dbg_log_gmem_load_store_skips(struct tu_device *device);
       mesa_log(MESA_LOG_WARN, (MESA_LOG_TAG), (fmt), ##__VA_ARGS__);    \
 } while(0)
 
+/* This build changes several defaults for native mobile games (see the patches). TU_PROFILE=stock puts every one of
+ * them back to the upstream behaviour at once, which is the quick way to A/B test a build against stock Turnip.
+ */
+bool
+tu_stock_profile(void);
+
 #define sizeof_field(s, field) sizeof(((s *) NULL)->field)
 
 #define offsetof_arr(s, field, idx)                                          \
-- 
2.43.0

