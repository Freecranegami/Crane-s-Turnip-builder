# Upstream Mesa source and the ref to track
MESA_REPO=https://gitlab.freedesktop.org/mesa/mesa.git
MESA_REF=main

# Android build settings
ANDROID_API=34          # target API for the cross compiler
PLATFORM_SDK_VERSION=34 # passed to meson -Dplatform-sdk-version
NDK_VERSION=r29

# Output naming
DRIVER_NAME=turnip-custom
