From 61888106d83250e366f757d3339d98cec18c1943 Mon Sep 17 00:00:00 2001
From: turnip-custom <turnip-custom@localhost>
Date: Thu, 12 Nov 2026 12:56:49 +0000
Subject: [PATCH 2/4] tu/autotune: collect the samples-passed metric sparsely
 once converged

The bandwidth algorithm needs a handful of samples-passed results per render
pass to settle on a mean. Afterwards, collecting it for every instance only
costs extra ZPASS_DONE events and BO write-backs. Keep collecting for the first
32 results, then for every 16th instance so the mean still follows scene changes.

TU_AUTOTUNE_RESAMPLE_PERIOD=<1..1024> overrides the period (1 = stock).
---
 src/freedreno/vulkan/tu_autotune.cc | 45 ++++++++++++++++++++++++++++-
 1 file changed, 44 insertions(+), 1 deletion(-)

diff --git a/src/freedreno/vulkan/tu_autotune.cc b/src/freedreno/vulkan/tu_autotune.cc
index 7c98c38..ff77e89 100644
--- a/src/freedreno/vulkan/tu_autotune.cc
+++ b/src/freedreno/vulkan/tu_autotune.cc
@@ -114,2 +114,19 @@ sysmem_penalty_percent()
 
+/* Once the samples-passed average of a render pass has converged, only every Nth instance of that render pass still
+ * collects the metric. Collecting it costs extra ZPASS_DONE events on the GPU and a BO write-back for every instance.
+ *
+ * 1 collects for every instance (stock behaviour). Override with TU_AUTOTUNE_RESAMPLE_PERIOD (1..1024).
+ */
+constexpr uint32_t RESAMPLE_PERIOD_DEFAULT = 16;
+
+static uint32_t
+resample_period()
+{
+   static const uint32_t period = []() {
+      long value = debug_get_num_option("TU_AUTOTUNE_RESAMPLE_PERIOD", RESAMPLE_PERIOD_DEFAULT);
+      return (uint32_t) CLAMP(value, 1, 1024);
+   }();
+   return period;
+}
+
 /** Configuration **/
@@ -193,2 +210,8 @@ struct PACKED tu_autotune::config_t {
 
+   /* Drops a metric for an individual entry, the algorithm and the other metrics stay as they are. */
+   constexpr void clear(metric_flag f)
+   {
+      metric_flags &= ~static_cast<uint8_t>(f);
+   }
+
    constexpr bool disable(mod_flag f)
@@ -1005,2 +1028,7 @@ struct tu_autotune::rp_history {
 
+      /* Amount of results the average needs before it is trusted, and counters for the sparse sampling afterwards. */
+      static constexpr uint32_t CONVERGENCE_UPDATES = 32;
+      std::atomic<uint32_t> update_count = 0;
+      std::atomic<uint32_t> instance_count = 0;
+
     public:
@@ -1009,2 +1037,12 @@ struct tu_autotune::rp_history {
          mean_samples_passed.add(samples);
+         if (update_count.load(std::memory_order_relaxed) < CONVERGENCE_UPDATES)
+            update_count.fetch_add(1, std::memory_order_relaxed);
+      }
+
+      /* Whether the next instance of this render pass should collect the samples-passed metric. */
+      bool should_sample()
+      {
+         if (update_count.load(std::memory_order_relaxed) < CONVERGENCE_UPDATES)
+            return true;
+         return instance_count.fetch_add(1, std::memory_order_relaxed) % resample_period() == 0;
       }
@@ -1899,3 +1937,8 @@ tu_autotune::get_optimal_mode(struct tu_cmd_buffer *cmd_buffer, rp_ctx_t *rp_ctx
    }
-   *rp_ctx = cb_ctx.attach_rp_entry(device, history, config, rp_state->drawcall_count);
+   /* The entry keeps its own copy of the config, so dropping the metric here only affects this instance. */
+   config_t entry_config = config;
+   if (config.is_enabled(algorithm::BANDWIDTH) && !history.bandwidth.should_sample())
+      entry_config.clear(metric_flag::SAMPLES);
+
+   *rp_ctx = cb_ctx.attach_rp_entry(device, history, entry_config, rp_state->drawcall_count);
 
