From 7e820ebd0d2a1f2ca6b2f3b208bd2af811eb07d0 Mon Sep 17 00:00:00 2001
From: turnip-custom <turnip-custom@localhost>
Date: Thu, 12 Nov 2026 12:56:25 +0000
Subject: [PATCH 1/4] tu/autotune: bias the bandwidth heuristic towards GMEM

SYSMEM traffic goes to DDR while GMEM traffic stays on-chip, so equal byte
counts do not cost equal energy. Weight the SYSMEM estimate up by 25% so that
near-ties go to GMEM, which reduces memory traffic, power draw and heat.

TU_AUTOTUNE_SYSMEM_PENALTY=<50..400> overrides the weight (100 = stock).
---
 src/freedreno/vulkan/tu_autotune.cc | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/freedreno/vulkan/tu_autotune.cc b/src/freedreno/vulkan/tu_autotune.cc
index 028e928..7c98c38 100644
--- a/src/freedreno/vulkan/tu_autotune.cc
+++ b/src/freedreno/vulkan/tu_autotune.cc
@@ -13,6 +13,7 @@
 #include <string_view>
 
 #include "util/rand_xor.h"
+#include "util/u_debug.h"
 
 #define XXH_INLINE_ALL
 #include "util/xxhash.h"
@@ -91,6 +92,26 @@ render_mode_str(tu_autotune::render_mode mode)
    }
 }
 
+/* How much more expensive SYSMEM rendering is considered to be than the raw bandwidth estimate says, in percent.
+ *
+ * The bandwidth heuristic only counts bytes. SYSMEM traffic goes to DDR, while GMEM traffic stays on-chip, so a byte of
+ * SYSMEM traffic costs more energy than a byte of GMEM traffic. Weighting SYSMEM up makes near-ties go to GMEM, which
+ * lowers memory traffic, power draw and heat at a small cost in peak FPS on some passes.
+ *
+ * 100 restores the stock behaviour. Override with the TU_AUTOTUNE_SYSMEM_PENALTY environment variable (50..400).
+ */
+constexpr uint32_t SYSMEM_PENALTY_PERCENT_DEFAULT = 125;
+
+static uint32_t
+sysmem_penalty_percent()
+{
+   static const uint32_t percent = []() {
+      long value = debug_get_num_option("TU_AUTOTUNE_SYSMEM_PENALTY", SYSMEM_PENALTY_PERCENT_DEFAULT);
+      return (uint32_t) CLAMP(value, 50, 400);
+   }();
+   return percent;
+}
+
 /** Configuration **/
 
 enum class tu_autotune::algorithm : uint8_t {
@@ -1030,7 +1051,8 @@ struct tu_autotune::rp_history {
           */
          gmem_bandwidth = (gmem_bandwidth * 11 + total_draw_call_bandwidth) / 10;
 
-         bool select_sysmem = sysmem_bandwidth <= gmem_bandwidth;
+         /* Bias near-ties towards GMEM, see sysmem_penalty_percent(). */
+         bool select_sysmem = (sysmem_bandwidth * sysmem_penalty_percent()) / 100 <= gmem_bandwidth;
          render_mode mode = select_sysmem ? render_mode::SYSMEM : render_mode::GMEM;
 
          UNUSED const VkExtent2D &extent = cmd_state->render_areas[0].extent;
