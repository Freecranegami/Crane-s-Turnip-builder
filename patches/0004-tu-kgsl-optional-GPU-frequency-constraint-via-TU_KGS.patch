From 230b34bbd5fb5ea9d4c91634be3e26d041ac7ad2 Mon Sep 17 00:00:00 2001
From: turnip-custom <turnip-custom@localhost>
Date: Thu, 12 Nov 2026 12:57:36 +0000
Subject: [PATCH 4/4] tu/kgsl: optional GPU frequency constraint via
 TU_KGSL_PWR_PERCENT

KGSL can hold a context at a fixed percentage of the maximum GPU frequency
(KGSL_CONSTRAINT_PWR_PERC_*) while it submits work. Expose it through
TU_KGSL_PWR_PERCENT=<2..100>. It is off by default, and a kernel that rejects
the request leaves the context unconstrained.
---
 src/freedreno/vulkan/tu_knl_kgsl.cc | 53 ++++++++++++++++++++++++++++-
 1 file changed, 52 insertions(+), 1 deletion(-)

diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index f792356..7280ea7 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -49,2 +49,21 @@ safe_ioctl(int fd, unsigned long request, void *arg)
 
+/* Optional GPU frequency constraint, as a percentage of the maximum GPU frequency (2..100).
+ *
+ * KGSL lets a context hold the GPU at a fixed share of its maximum frequency (KGSL_CONSTRAINT_PWR_PERC_*) while that
+ * context submits work. With a value below 100 this trades peak performance for lower power draw and heat. It is off
+ * unless TU_KGSL_PWR_PERCENT is set, and the kernel decides what to do with it: devices that do not support it
+ * reject the request and the context simply runs unconstrained.
+ */
+static uint32_t
+kgsl_pwr_percent()
+{
+   static const uint32_t percent = []() {
+      long value = debug_get_num_option("TU_KGSL_PWR_PERCENT", 0);
+      if (value < KGSL_CONSTRAINT_PWR_PERC_MIN || value > KGSL_CONSTRAINT_PWR_PERC_MAX)
+         return (uint32_t) 0;
+      return (uint32_t) value;
+   }();
+   return percent;
+}
+
 static int
@@ -52,2 +71,4 @@ kgsl_submitqueue_new(struct tu_device *dev, struct tu_queue *queue)
 {
+   const uint32_t pwr_percent = kgsl_pwr_percent();
+
    struct kgsl_drawctxt_create req = {
@@ -55,3 +76,4 @@ kgsl_submitqueue_new(struct tu_device *dev, struct tu_queue *queue)
               KGSL_CONTEXT_NO_GMEM_ALLOC |
-              KGSL_CONTEXT_PREAMBLE,
+              KGSL_CONTEXT_PREAMBLE |
+              (pwr_percent ? (unsigned) KGSL_CONTEXT_PWR_CONSTRAINT : 0u),
    };
@@ -59,2 +81,7 @@ kgsl_submitqueue_new(struct tu_device *dev, struct tu_queue *queue)
    int ret = safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_DRAWCTXT_CREATE, &req);
+   if (ret && pwr_percent) {
+      /* A kernel that does not know the power constraint flag may reject the context, so retry without it. */
+      req.flags &= ~(unsigned) KGSL_CONTEXT_PWR_CONSTRAINT;
+      ret = safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_DRAWCTXT_CREATE, &req);
+   }
    if (ret)
@@ -64,2 +91,26 @@ kgsl_submitqueue_new(struct tu_device *dev, struct tu_queue *queue)
 
+   if (pwr_percent && (req.flags & KGSL_CONTEXT_PWR_CONSTRAINT)) {
+      struct kgsl_device_constraint_pwrlevel pwrlevel = {
+         .level = pwr_percent,
+      };
+      struct kgsl_device_constraint constraint = {
+         .type = KGSL_CONSTRAINT_PWRLEVEL,
+         .context_id = req.drawctxt_id,
+         .data = &pwrlevel,
+         .size = sizeof(pwrlevel),
+      };
+      struct kgsl_device_getproperty prop = {
+         .type = KGSL_PROP_PWR_CONSTRAINT,
+         .value = &constraint,
+         .sizebytes = sizeof(constraint),
+      };
+
+      /* Best effort, a failure is not an error for the application. */
+      int prop_ret = safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_SETPROPERTY, &prop);
+      if (TU_DEBUG(STARTUP)) {
+         mesa_logi("kgsl: GPU frequency constraint %u%% %s", pwr_percent,
+                   prop_ret ? "rejected by the kernel" : "applied");
+      }
+   }
+
    return 0;
-- 
